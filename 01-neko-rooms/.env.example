# Copy to .env and adjust.
#
# PUBLIC_HOST is the externally-reachable hostname or IP of THIS docker
# host. It must be reachable from any client that wants to use the
# prototype (so neither "localhost" nor "127.0.0.1" unless you're only
# ever using the host locally).
#
# Examples:
#   PUBLIC_HOST=10.0.0.42           # LAN IP
#   PUBLIC_HOST=neko.lan            # mDNS / DNS name
#   PUBLIC_HOST=my.example.com      # public DNS
#
# Leave the value blank to force an explicit override before bring-up;
# `docker compose` will fail fast rather than silently bind to a stale
# default.
PUBLIC_HOST=

# Optional: force the dispatcher's 302 Location host (instead of using
# the request's Host header). Leave empty for default behaviour.
# DISPATCHER_PUBLIC_HOST=neko.example.com
