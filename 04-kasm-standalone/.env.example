# Copy to .env and edit; docker compose will pick it up automatically.

# TCP port the dispatcher itself listens on. Must be free on the host.
DISPATCHER_PORT=6081

# Inclusive range of host ports the dispatcher hands out to viewer
# containers. Picked to avoid the other prototypes on this host:
#   3000               (kasm-orchestrator)
#   7080, 7081         (guacamole, guac dispatcher)
#   8080, 8081         (neko-rooms, neko dispatcher)
#   9081, 9082-9099    (xpra dispatcher + viewers)
#   32768-32770        (kasm-orchestrator-spawned viewers)
VIEWER_PORT_RANGE_START=6082
VIEWER_PORT_RANGE_END=6099

# KasmVNC TLS opt-out. The container's NoVNC endpoint speaks plain HTTP
# when this is "disabled" — required so users don't hit a self-signed
# cert warning. If you ever need to test the original behaviour, set
# KASM_SVC_HTTPS_VALUE=enabled and the dispatcher will pass through.
# Documented values that work on kasmweb/* 1.16.0: "disabled".
# Values that did NOT work in our testing: "no", "0", "false" (ignored).
KASM_SVC_HTTPS_VALUE=disabled

# Seconds the dispatcher waits for a freshly-spawned viewer to start
# returning HTTP 200 on / before redirecting. chromium cold-start is the
# slowest case (~15-25 s); we leave 60 s of headroom.
READY_TIMEOUT_S=60

# Optional override of the host part used in the 302 Location. Leave
# blank to use the incoming request's Host header (recommended for LAN
# use). Set this to a stable name/IP if the dispatcher is behind a
# reverse proxy that strips Host.
PUBLIC_HOST=

# Per-viewer resource caps. Bump these if chromium starts OOM-killing
# big PDFs.
VIEWER_MEMORY=2g
VIEWER_CPUS=2.0
