# Local environment overrides — copy from .env.example and edit per host.
.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Docker / build artifacts
*.log

# Webtop bind-mount runtime state (XFCE/proot-apps/desktop user data).
# These dirs are populated by the LSIO webtop container at runtime —
# they contain the in-container user's home (~1GB of installed apps,
# core dumps, private SSH/GPG keys, etc.). Not source.
06-lsio-webtop/config/
07-control-center-webtop/config/

# Per-host self-signed certs generated by the control-center on first boot.
07-control-center-webtop/certs/
