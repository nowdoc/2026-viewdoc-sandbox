# Copy to .env and edit; docker compose picks it up automatically.

# TCP port the control-center listens on. Must be free on the host.
CONTROL_CENTER_PORT=5081

# Pool config. POOL_SIZE pre-warmed containers, deterministically mapped to
# host ports [VIEWER_PORT_RANGE_START, START+POOL_SIZE-1]. Stay clear of:
#   3000              kasm-orchestrator
#   6081-6099         04 prototype
#   7080-81           guacamole
#   8080-81           neko-rooms
#   9081, 9082-9099   xpra
#   32768-32770       kasm-orchestrator viewers
VIEWER_POOL_SIZE=3
VIEWER_PORT_RANGE_START=5082

# Pool image. Built locally from images/Dockerfile.ubuntu (see README).
POOL_IMAGE=kasm2-cc/ubuntu:latest

# Instance label. Set to different values when running multiple
# control-center instances on the same host so each owns its own slots.
POOL_INSTANCE=default

# Seconds we wait for each pool slot to start serving HTTP at startup.
# Bumped from 90s because amd64 under QEMU on aarch64 cold-starts slowly.
# (Pool containers are always amd64 — that's the only arch Kasm's apps
# install on. See PLAN.md.)
READY_TIMEOUT_S=180

# KasmVNC TLS opt-out so iframes load via plain http.
KASM_SVC_HTTPS_VALUE=disabled

# Optional override for the host part of the viewer URL we hand the browser.
# Leave blank to derive from the user's Host header (recommended for LAN use).
PUBLIC_HOST=

# Per-pool-slot resource caps.
VIEWER_MEMORY=2g
VIEWER_CPUS=2.0

# Stream-quality + clipboard defaults injected into the iframe viewer URL.
# These map 1:1 to KasmVNC NoVNC URL params; see KasmVNC docs for full ranges.
#   quality                JPEG/WebP quality, 0..9 (default 6 upstream)
#   compression            zlib level 0..9 (lower = lower CPU, more bytes)
#   dynamic_quality_min/max  adaptive encoder bounds 0..9
#   prefer_local_cursor    render cursor in-browser (cheaper than streaming)
#   clipboard_*            clipboard wiring. seamless = auto-sync both ways
#                          when the page is in a secure context (HTTPS/localhost)
#   resize                 'remote' = server matches iframe size; 'scale' to letterbox
VIEWER_QUALITY=9
VIEWER_COMPRESSION=2
VIEWER_DYNAMIC_QUALITY_MIN=7
VIEWER_DYNAMIC_QUALITY_MAX=9
VIEWER_PREFER_LOCAL_CURSOR=1
VIEWER_CLIPBOARD_UP=1
VIEWER_CLIPBOARD_DOWN=1
VIEWER_CLIPBOARD_SEAMLESS=1
VIEWER_RESIZE=remote

# Dual-stack TLS on CONTROL_CENTER_PORT. With TLS_ENABLED=1, the server sniffs
# the first byte and speaks either plain HTTP or TLS on the same port (same
# trick KasmVNC uses for slot ports). Required for the clipboard API to
# survive in the iframe — see README → Clipboard. Self-signed cert lives in
# the cc-state volume so the cert prompt only fires once per port.
TLS_ENABLED=1

# Optional: Subject Alt Names baked into the auto-generated self-signed
# cert. Default (when unset) is "DNS:localhost,IP:127.0.0.1,IP:::1" —
# enough for `localhost`. Add the LAN / mDNS / wildcard hostnames you
# actually hit the control-center on. Delete the cc-state volume after
# changing this to force regeneration.
#   TLS_CERT_SAN=DNS:localhost,DNS:viewer.lan,DNS:*.viewer.lan,IP:127.0.0.1,IP:::1
# TLS_CERT_SAN=
