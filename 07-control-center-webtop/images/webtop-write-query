#!/usr/bin/env python3
"""Atomic writer for /tmp/webtop_query.{json,env}.

Reads a JSON blob on stdin in the form:

    {"params": {"open_url": "https://example.com/x.pdf"}, "raw": "open_url=..."}

…and writes /tmp/webtop_query.json (pretty-printed) plus
/tmp/webtop_query.env (WEBTOP_Q_<UPPER>=<value>, shell-sourceable), both
via temp + os.replace so readers never see a partial file.

After the write, if /usr/local/bin/webtop-on-query-update.sh exists and is
executable, we invoke it as a detached child — that's the documented
extension point for apps inside the desktop to react to URL changes from
the parent control-center.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import tempfile

OUT_JSON = "/tmp/webtop_query.json"
OUT_ENV = "/tmp/webtop_query.env"
HOOK = "/usr/local/bin/webtop-on-query-update.sh"


def _atomic_write(path: str, data: str) -> None:
    d = os.path.dirname(path) or "/tmp"
    fd, tmp = tempfile.mkstemp(prefix=".webtop_q_", dir=d)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(data)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise


def main() -> int:
    blob = sys.stdin.read()
    if not blob.strip():
        print("webtop-write-query: empty stdin", file=sys.stderr)
        return 2
    try:
        payload = json.loads(blob)
    except json.JSONDecodeError as e:
        print(f"webtop-write-query: bad json: {e}", file=sys.stderr)
        return 2
    params = payload.get("params") or {}
    if not isinstance(params, dict):
        print("webtop-write-query: params must be object", file=sys.stderr)
        return 2
    raw = payload.get("raw") or ""

    _atomic_write(OUT_JSON, json.dumps({"params": params, "raw": raw}, indent=2) + "\n")

    def shq(s: str) -> str:
        return "'" + s.replace("'", "'\\''") + "'"

    lines = [f"WEBTOP_Q_{k.upper()}={shq(v)}" for k, v in params.items()]
    lines.append(f"WEBTOP_QUERY={shq(raw)}")
    lines.append("WEBTOP_QUERY_KEYS=" + shq(" ".join(params.keys())))
    _atomic_write(OUT_ENV, "\n".join(lines) + "\n")

    if os.access(HOOK, os.X_OK):
        try:
            with open("/tmp/on_query_update.log", "a") as logf:
                subprocess.Popen(
                    [HOOK],
                    stdout=logf,
                    stderr=subprocess.STDOUT,
                    stdin=subprocess.DEVNULL,
                    env={**os.environ, "WEBTOP_QUERY_JSON": OUT_JSON,
                         "WEBTOP_QUERY_ENV": OUT_ENV},
                    start_new_session=True,
                )
        except Exception as e:
            print(f"webtop-write-query: hook spawn failed: {e}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
